# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Runtime
NODE_ENV=development
PORT=3000
# Max request body in bytes the server accepts (US-024). Oversized bodies are rejected by
# Bun before a handler buffers them. Default 6 MB (covers the 5 MB dish image + overhead).
MAX_REQUEST_BODY_BYTES=6000000

# Log verbosity: trace | debug | info | warn | error | fatal.
# Default: debug in development, info in production.
LOG_LEVEL=debug

# Neon Postgres connection string.
# Use the pooled (-pooler) host for app traffic; a direct host for migrations.
# Get it from the Neon console or: neonctl connection-string <branch>
#
# Use sslmode=verify-full (not require): Neon presents a valid cert, and a future
# pg/pg-connection-string major will downgrade `require` to weaker, unverified TLS.
# verify-full is the secure, future-proof value and silences the deprecation warning.
#
# ENFORCED (US-027): outside NODE_ENV=test, the app fails fast at startup unless sslmode is
# require, verify-ca, or verify-full — a missing/disable/allow sslmode refuses to boot.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Auth (US-009). JWT signing secret — REQUIRED in every environment except tests (forging
# access tokens is trivial with a known secret). Use a long random value, e.g.
# `openssl rand -base64 48`. A dev fallback is used ONLY when NODE_ENV=test; any other
# environment (production, staging, unset NODE_ENV) fails fast at startup if this is unset
# (US-022 / decision 0023).
AUTH_JWT_SECRET=
# Access token lifetime in seconds (default 900 = 15 min).
AUTH_ACCESS_TOKEN_TTL=900
# Refresh token lifetime in days (default 30).
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Rate limiting (US-023, decision 0023). Enabled everywhere except NODE_ENV=test by
# default; set RATE_LIMIT_ENABLED=false/true to override. Login is throttled per-IP and
# per-account; QR/upload routes have a global per-IP limit. Behind a proxy/CDN, set
# RATE_LIMIT_TRUSTED_PROXY_HEADER to the header carrying the real client IP (e.g.
# x-forwarded-for); leave it unset to use the socket IP and ignore forwarded headers.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_TRUSTED_PROXY_HEADER=x-forwarded-for
AUTH_LOGIN_RATE_MAX=10
AUTH_LOGIN_RATE_WINDOW_SEC=60
GLOBAL_RATE_MAX=120
GLOBAL_RATE_WINDOW_SEC=60

# Dish image upload / Cloudflare R2 (US-021, decision 0021). All five are REQUIRED
# together in production; outside production they are optional and the image-upload
# endpoint returns STORAGE_UNAVAILABLE (503) until they are set. R2 is S3-compatible.
# Create an R2 API token (Object Read & Write) in the Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL the bucket is served from (r2.dev dev URL or a custom domain),
# no trailing slash. Uploaded image URLs are R2_PUBLIC_BASE_URL + "/" + object key.
R2_PUBLIC_BASE_URL=
